// turbo-pancake main window (S0 shell + S1/S2 voice room panel + S3/S4 screen share).
// Layout follows the spec: conversation list on the left, conversation area on
// the right, user panel at the bottom-left. No server/channel rail by design.

import { Button, LineEdit, CheckBox, ComboBox, Slider, Palette } from "std-widgets.slint";
import { Theme, IconButton } from "theme.slint";
import { ConversationRow, MessageRow, GroupMemberRow, Sidebar, AuthPanel, ChatPanel } from "chat.slint";
export { Theme, ConversationRow, MessageRow, GroupMemberRow }

// One other member of the voice room.
export struct MemberRow {
    peer-id: string,
    name: string,
    speaking: bool,
    // Local volume, percent (0–200).
    volume: float,
    info: string,
}

// Another member's active screen share.
export struct ShareRow {
    peer-id: string,
    name: string,
    info: string,
    watching: bool,
    // Its preview picture (S4) while one is received.
    preview: image,
    has-preview: bool,
    // Preview stream id (SSRC as int; 0 = none) to match decoded pictures.
    preview-ssrc: int,
}

// A member of the call: speaking indicator, name, own volume slider.
component MemberItem inherits Rectangle {
    in property <MemberRow> member;
    callback volume-changed(float);
    height: 44px;
    border-radius: 4px;
    background: Theme.bg-secondary;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        // Speaking indicator: a green ring around the avatar.
        Rectangle {
            width: 28px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            border-width: 2px;
            border-color: root.member.speaking ? #23a55a : transparent;
            background: Theme.accent;
            accessible-role: text;
            accessible-label: root.member.speaking ? "говорит" : "молчит";
            Text {
                text: root.member.name.character-count > 0 ? "●" : "?";
                color: white;
                font-size: 10px;
            }
        }
        VerticalLayout {
            alignment: center;
            min-width: 120px;
            Text {
                text: root.member.name;
                color: Theme.text-normal;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.member.info;
                color: Theme.text-muted;
                font-size: 11px;
                overflow: elide;
            }
        }
        Slider {
            minimum: 0;
            maximum: 200;
            value: root.member.volume;
            changed(v) => { root.volume-changed(v); }
        }
        Text {
            width: 48px;
            text: round(root.member.volume) + " %";
            color: Theme.text-muted;
            vertical-alignment: center;
        }
    }
}

// S1/S2: a voice room joined by id (accounts and dialogs arrive in S5).
component CallPanel inherits Rectangle {
    in property <bool> managed;
    in property <bool> has-participation;
    in-out property <string> room-text;
    in property <bool> in-room;
    in property <string> title;
    in property <string> detail;
    in property <string> stats;
    in property <string> devices;
    in property <string> error;
    in property <float> mic-level;
    in property <bool> self-speaking;
    in property <bool> dsp-available;
    in property <[MemberRow]> members;
    in-out property <bool> voice-activation;
    // Voice activation threshold, dBFS (meter range -60..0).
    in-out property <float> vad-threshold: -45;
    in-out property <bool> muted;
    in-out property <bool> ns: true;
    in-out property <bool> aec: true;
    in property <[string]> inputs;
    in property <[string]> outputs;
    in-out property <int> input-index;
    in-out property <int> output-index;
    in-out property <float> remote-volume: 100;
    callback join(string);
    callback leave();
    callback mute-changed(bool);
    callback dsp-changed(bool, bool);
    callback input-selected(int);
    callback output-selected(int);
    callback remote-volume-changed(float);
    callback member-volume-changed(string, float);
    callback vad-changed(bool, float);

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        alignment: start;
        Text {
            text: root.title;
            color: Theme.text-normal;
            font-size: 20px;
            font-weight: 700;
        }
        Text {
            text: root.detail;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            if !root.managed: LineEdit {
                placeholder-text: "id комнаты";
                text <=> root.room-text;
                enabled: !root.in-room;
                accepted(t) => { root.join(t); }
            }
            Button {
                text: root.managed ? "Завершить звонок" : root.in-room ? "Выйти" : "Войти";
                enabled: !root.managed || root.has-participation;
                primary: !root.in-room;
                clicked => {
                    if root.in-room || root.managed {
                        root.leave();
                    } else {
                        root.join(root.room-text);
                    }
                }
            }
        }
        // Wraps instead of being cut at the panel's width (narrow window, large scale).
        FlexboxLayout {
            spacing: 12px;
            Button {
                text: root.muted ? "Включить микрофон" : "Выключить микрофон";
                clicked => {
                    root.muted = !root.muted;
                    root.mute-changed(root.muted);
                }
            }
            CheckBox {
                text: "Шумоподавление";
                enabled: root.dsp-available;
                checked <=> root.ns;
                toggled => { root.dsp-changed(root.ns, root.aec); }
            }
            CheckBox {
                text: "Эхоподавление";
                enabled: root.dsp-available;
                checked <=> root.aec;
                toggled => { root.dsp-changed(root.ns, root.aec); }
            }
        }
        // Microphone level in dB (what the others hear; zero while muted), green while
        // speaking; the white mark is the voice activation threshold.
        Rectangle {
            height: 8px;
            border-radius: 4px;
            background: Theme.bg-tertiary;
            Rectangle {
                x: 0;
                width: parent.width * root.mic-level;
                height: parent.height;
                border-radius: 4px;
                background: root.self-speaking ? #23a55a : Theme.text-muted;
            }
            if root.voice-activation: Rectangle {
                x: parent.width * (root.vad-threshold + 60) / 60 - 1px;
                width: 2px;
                height: parent.height;
                background: Theme.text-normal;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            CheckBox {
                text: "Активация голосом";
                checked <=> root.voice-activation;
                toggled => { root.vad-changed(root.voice-activation, root.vad-threshold); }
            }
            Slider {
                enabled: root.voice-activation;
                minimum: -60;
                maximum: 0;
                value <=> root.vad-threshold;
                changed(v) => { root.vad-changed(root.voice-activation, v); }
            }
            Text {
                width: 56px;
                text: round(root.vad-threshold) + " дБ";
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }
        GridLayout {
            spacing: 8px;
            Row {
                Text {
                    text: "Микрофон";
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                ComboBox {
                    model: root.inputs;
                    current-index <=> root.input-index;
                    selected => { root.input-selected(self.current-index); }
                }
            }
            Row {
                Text {
                    text: "Вывод";
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                ComboBox {
                    model: root.outputs;
                    current-index <=> root.output-index;
                    selected => { root.output-selected(self.current-index); }
                }
            }
            Row {
                Text {
                    text: "Громкость звонка";
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Slider {
                        minimum: 0;
                        maximum: 200;
                        value <=> root.remote-volume;
                        changed(v) => { root.remote-volume-changed(v); }
                    }
                    Text {
                        width: 48px;
                        text: round(root.remote-volume) + " %";
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                }
            }
        }
        if root.members.length > 0: Text {
            text: "УЧАСТНИКИ — " + root.members.length;
            color: Theme.text-muted;
            font-size: 11px;
            font-weight: 700;
        }
        for m in root.members: MemberItem {
            member: m;
            volume-changed(v) => { root.member-volume-changed(m.peer-id, v); }
        }
        Text {
            text: root.devices;
            color: Theme.text-muted;
            font-size: 12px;
            wrap: word-wrap;
        }
        Text {
            text: root.stats;
            color: Theme.text-muted;
            font-size: 12px;
            wrap: word-wrap;
        }
        Text {
            text: root.error;
            color: #f23f43;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

// S3/S4: share a whole monitor, see who shares (previews), watch one share in the
// quality you pick, full screen or in its own window.
component ScreenPanel inherits Rectangle {
    in property <bool> in-room;
    in property <[string]> monitors;
    in-out property <int> monitor-index;
    in-out property <int> quality-index;
    in-out property <bool> adaptive: true;
    in-out property <bool> share-audio: true;
    in property <bool> sharing;
    in property <string> share-info;
    in property <[ShareRow]> shares;
    in property <string> watching;
    in property <image> picture;
    in property <bool> has-picture;
    in property <string> viewer-info;
    in-out property <int> layer-index;
    in property <string> layer-info;
    in-out property <bool> previews-visible: true;
    in-out property <float> tile-width: 160;
    in property <int> preview-page;
    in property <int> preview-pages;
    in property <string> preview-info;
    in property <bool> share-window-open;
    callback start-share(int, int, bool);
    callback stop-share();
    callback watch(string);
    callback share-audio-changed(bool);
    callback layer-selected(int);
    callback previews-changed(bool, int);
    callback open-share-window(bool);
    background: Theme.bg-primary;

    VerticalLayout {
        padding: 24px;
        spacing: 8px;
        Text {
            text: "ДЕМОНСТРАЦИЯ ЭКРАНА";
            color: Theme.text-muted;
            font-size: 11px;
            font-weight: 700;
        }
        HorizontalLayout {
            spacing: 8px;
            ComboBox {
                model: root.monitors;
                current-index <=> root.monitor-index;
                enabled: root.in-room;
                selected => {
                    // Switching the monitor while sharing restarts the share on it.
                    if root.sharing {
                        root.start-share(root.monitor-index, root.quality-index, root.adaptive);
                    }
                }
            }
            ComboBox {
                model: ["1440p · 120 к/с", "1080p · 60 к/с", "720p · 30 к/с"];
                current-index <=> root.quality-index;
                enabled: root.in-room;
                selected => {
                    if root.sharing {
                        root.start-share(root.monitor-index, root.quality-index, root.adaptive);
                    }
                }
            }
            Button {
                text: root.sharing ? "Остановить показ" : "Показать экран";
                primary: !root.sharing;
                enabled: root.in-room && root.monitors.length > 0;
                clicked => {
                    if root.sharing {
                        root.stop-share();
                    } else {
                        root.start-share(root.monitor-index, root.quality-index, root.adaptive);
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 16px;
            CheckBox {
                text: "Подстраивать под сеть";
                checked <=> root.adaptive;
                toggled => {
                    if root.sharing {
                        root.start-share(root.monitor-index, root.quality-index, root.adaptive);
                    }
                }
            }
            CheckBox {
                text: "Звук компьютера (без звука мессенджера)";
                checked <=> root.share-audio;
                toggled => { root.share-audio-changed(root.share-audio); }
            }
        }
        if root.share-info != "": Text {
            text: root.share-info;
            color: Theme.text-muted;
            font-size: 12px;
            wrap: word-wrap;
        }
        // Previews: every share as a thumbnail (its low layer); click to watch.
        HorizontalLayout {
            spacing: 10px;
            CheckBox {
                text: "Миниатюры";
                checked <=> root.previews-visible;
                toggled => { root.previews-changed(root.previews-visible, root.preview-page); }
            }
            Text {
                text: "Размер";
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            Slider {
                minimum: 96;
                maximum: 320;
                value <=> root.tile-width;
                enabled: root.previews-visible;
            }
            if root.preview-pages > 1: Button {
                text: "◀";
                enabled: root.preview-page > 0;
                clicked => { root.previews-changed(true, root.preview-page - 1); }
            }
            if root.preview-pages > 1: Text {
                text: (root.preview-page + 1) + " / " + root.preview-pages;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            if root.preview-pages > 1: Button {
                text: "▶";
                enabled: root.preview-page + 1 < root.preview-pages;
                clicked => { root.previews-changed(true, root.preview-page + 1); }
            }
        }
        if root.in-room && root.shares.length == 0: Text {
            text: "Никто не показывает экран.";
            color: Theme.text-muted;
        }
        grid := Flickable {
            property <length> tile-w: root.tile-width * 1px;
            property <length> tile-h: self.tile-w * 9 / 16 + 34px;
            property <int> cols: max(1, floor((self.width + 8px) / (self.tile-w + 8px)));
            height: root.shares.length == 0 ? 0px : min(2 * (self.tile-h + 8px), ceil(root.shares.length / self.cols) * (self.tile-h + 8px));
            content-height: ceil(root.shares.length / self.cols) * (self.tile-h + 8px);
            for s[i] in root.shares: Rectangle {
                x: mod(i, grid.cols) * (grid.tile-w + 8px);
                y: floor(i / grid.cols) * (grid.tile-h + 8px);
                width: grid.tile-w;
                height: grid.tile-h;
                border-radius: 4px;
                background: s.watching ? Theme.accent.darker(0.4) : Theme.bg-secondary;
                TouchArea {
                    clicked => { root.watch(s.watching ? "" : s.peer-id); }
                }
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    Rectangle {
                        background: Theme.bg-tertiary;
                        border-radius: 3px;
                        if s.has-preview: Image {
                            width: parent.width;
                            height: parent.height;
                            source: s.preview;
                            image-fit: contain;
                            accessible-role: image;
                            accessible-label: "миниатюра трансляции " + s.name;
                        }
                        if !s.has-preview: Text {
                            text: s.watching ? "Смотрите крупно" : (root.previews-visible ? "Миниатюра…" : "Миниатюры скрыты");
                            color: Theme.text-muted;
                            font-size: 11px;
                        }
                    }
                    HorizontalLayout {
                        height: 24px;
                        spacing: 4px;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: s.name;
                                color: Theme.text-normal;
                                font-weight: 600;
                                font-size: 12px;
                                overflow: elide;
                            }
                            Text {
                                text: s.info;
                                color: Theme.text-muted;
                                font-size: 10px;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
        if root.preview-info != "": Text {
            text: root.preview-info;
            color: Theme.text-muted;
            font-size: 11px;
            wrap: word-wrap;
        }
        // The watched share, letterboxed to the panel.
        if root.watching != "": HorizontalLayout {
            spacing: 8px;
            ComboBox {
                model: ["Качество: авто", "Высокое", "Низкое"];
                current-index <=> root.layer-index;
                selected => { root.layer-selected(root.layer-index); }
            }
            Button {
                text: "Во весь экран";
                clicked => { root.open-share-window(true); }
            }
            Button {
                text: root.share-window-open ? "Окно открыто" : "В отдельном окне";
                enabled: !root.share-window-open;
                clicked => { root.open-share-window(false); }
            }
            Button {
                text: "Не смотреть";
                clicked => { root.watch(""); }
            }
        }
        if root.layer-info != "": Text {
            text: root.layer-info;
            color: Theme.text-muted;
            font-size: 12px;
            wrap: word-wrap;
        }
        Rectangle {
            min-height: 120px;
            vertical-stretch: 1;
            background: Theme.bg-tertiary;
            border-radius: 4px;
            if root.has-picture && !root.share-window-open: Image {
                width: parent.width;
                height: parent.height;
                source: root.picture;
                image-fit: contain;
                accessible-role: image;
                accessible-label: "трансляция экрана";
            }
            if root.share-window-open: Text {
                text: "Трансляция показана в отдельном окне";
                color: Theme.text-muted;
            }
            if !root.has-picture && !root.share-window-open: Text {
                text: root.watching != "" ? "Ожидание трансляции…" : "Выберите трансляцию";
                color: Theme.text-muted;
            }
        }
        Text {
            text: root.viewer-info;
            color: Theme.text-muted;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

// One line over the content while a link is down or just came back (S7 step 4).
// Kind: 1 restored (green), 2 reconnecting (amber), 3 offline (red).
component ConnectionBanner inherits Rectangle {
    in property <int> kind;
    in property <string> text;
    min-height: 32px;
    background: root.kind == 3 ? #da373c : (root.kind == 2 ? #b07612 : #248046);
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;
        Text {
            text: root.kind == 1 ? "✓" : "!";
            color: #ffffff;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: #ffffff;
            font-weight: 600;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// The watched share in its own ordinary window (spec §5.1), optionally full screen.
export component ShareWindow inherits Window {
    title: "turbo-pancake — " + root.share-name;
    icon: @image-url("../../../assets/icon/turbo-pancake-64.png");
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 320px;
    min-height: 180px;
    background: #000000;
    in property <string> share-name;
    in property <image> picture;
    in property <bool> has-picture;
    in property <string> info;
    in-out property <bool> fullscreen;
    callback fullscreen-changed(bool);
    callback close-window();
    if root.has-picture: Image {
        width: parent.width;
        height: parent.height;
        source: root.picture;
        image-fit: contain;
        accessible-role: image;
        accessible-label: "трансляция экрана " + root.share-name;
    }
    if !root.has-picture: Text {
        text: "Ожидание трансляции…";
        color: #b5bac1;
    }
    TouchArea {
        double-clicked => {
            root.fullscreen = !root.fullscreen;
            root.fullscreen-changed(root.fullscreen);
        }
    }
    HorizontalLayout {
        alignment: end;
        y: 0px;
        height: 36px;
        padding: 4px;
        spacing: 4px;
        Text {
            text: root.info;
            color: #b5bac1;
            font-size: 11px;
            vertical-alignment: center;
        }
        Button {
            text: root.fullscreen ? "Обычное окно" : "Во весь экран";
            clicked => {
                root.fullscreen = !root.fullscreen;
                root.fullscreen-changed(root.fullscreen);
            }
        }
        Button {
            text: "Закрыть";
            clicked => { root.close-window(); }
        }
    }
}

export component MainWindow inherits Window {
    icon: @image-url("../../../assets/icon/turbo-pancake-64.png");
    in-out property <bool> group-settings-open;
    in-out property <bool> new-group-open;
    in property <bool> chat-group;
    in property <bool> chat-can-manage;
    in property <[GroupMemberRow]> group-members;
    in property <string> chat-call-label: "Позвонить";
    in property <string> active-call-title;
    in property <string> incoming-title;
    in property <bool> has-participation;
    callback create-group(string, string);
    callback rename-group(string);
    callback add-group-member(string);
    callback remove-group-member(string);
    callback conversation-call;
    callback accept-call;
    callback decline-call;
    callback retry-call;
    title: "turbo-pancake";
    preferred-width: 1280px;
    preferred-height: 700px;
    min-width: 640px;
    min-height: 420px;
    background: Theme.bg-primary;
    default-font-size: Theme.font-size;

    in property <string> user-name: "turbo-pancake";
    in property <string> connection-status: "Не подключено";
    in property <string> build-info;
    // Connection banner: 0 none, 1 restored, 2 reconnecting, 3 offline.
    in property <int> banner-kind;
    in property <string> banner-text;

    // Messenger (S5).
    in property <bool> signed-in;
    in property <string> server-label;
    in property <string> auth-error;
    in property <bool> auth-busy;
    in property <string> find-error;
    in property <[ConversationRow]> conversations;
    in-out property <bool> voice-selected;
    in property <string> current-conversation;
    in property <string> chat-title;
    in property <string> chat-username;
    in property <bool> chat-online;
    in property <bool> chat-can-send: true;
    in property <bool> chat-blocked-by-me;
    in property <[MessageRow]> messages;
    in property <string> compose-mode;
    in property <string> compose-label;
    in-out property <string> compose-text;
    callback login(string, string);
    callback register(string, string, string);
    callback logout();
    callback find-user(string);
    callback open-conversation(string);
    callback open-voice();
    callback send-message(string);
    callback reply-to(string);
    callback edit-message(string);
    callback delete-message(string);
    callback retry-message(string);
    callback discard-message(string);
    callback cancel-compose();
    callback toggle-block();
    callback draft-changed(string);

    in-out property <string> room-text;
    in property <bool> in-room;
    in property <string> call-title: "Не в звонке";
    in property <string> call-detail;
    in property <string> call-stats;
    in property <string> call-devices;
    in property <string> call-error;
    in property <float> mic-level;
    in property <bool> self-speaking;
    in property <bool> dsp-available;
    in property <[MemberRow]> members;
    in-out property <bool> voice-activation;
    // Voice activation threshold, dBFS (meter range -60..0).
    in-out property <float> vad-threshold: -45;
    in-out property <bool> muted;
    in-out property <bool> ns: true;
    in-out property <bool> aec: true;
    in property <[string]> inputs: ["По умолчанию"];
    in property <[string]> outputs: ["По умолчанию"];
    in-out property <int> input-index;
    in-out property <int> output-index;
    in-out property <float> remote-volume: 100;
    in property <[string]> monitors;
    in-out property <int> monitor-index;
    in-out property <int> quality-index;
    in-out property <bool> share-audio: true;
    in property <bool> sharing;
    in property <string> share-info;
    in property <[ShareRow]> shares;
    in property <string> watching;
    in property <image> screen-picture;
    in property <bool> has-picture;
    in property <string> viewer-info;
    in-out property <bool> adaptive: true;
    in-out property <int> layer-index;
    in property <string> layer-info;
    in-out property <bool> previews-visible: true;
    in-out property <float> tile-width: 160;
    in property <int> preview-page;
    in property <int> preview-pages;
    in property <string> preview-info;
    in property <bool> share-window-open;
    in property <string> watching-name;
    callback join(string);
    callback leave();
    callback mute-changed(bool);
    callback dsp-changed(bool, bool);
    callback input-selected(int);
    callback output-selected(int);
    callback remote-volume-changed(float);
    callback member-volume-changed(string, float);
    callback vad-changed(bool, float);
    callback start-share(int, int, bool);
    callback stop-share();
    callback watch(string);
    callback share-audio-changed(bool);
    callback layer-selected(int);
    callback previews-changed(bool, int);
    callback open-share-window(bool);

    // Application settings (S7): tray mode and an explicit exit.
    in-out property <bool> app-settings-open;
    in-out property <bool> close-to-tray: true;
    in property <bool> tray-available;
    // 0..4 = 100/125/150/175/200 % (applied at the next start).
    in-out property <int> ui-scale-index;
    callback ui-scale-changed(int);
    // Updates (S7 step 5): status line, the action button ("" hides it).
    in property <string> update-text: "Обновления не настроены в этой сборке";
    in property <string> update-button;
    in property <bool> update-available;
    callback update-action();
    // Narrow window (S7 step 3): the sidebar collapses behind a rail button.
    // Set from `changed width`, not bound: a binding would feed the layout's own width
    // back into the layout (binding loop).
    out property <bool> compact;
    changed width => { root.compact = root.width < 860px; }
    in-out property <bool> sidebar-open;
    // Narrow call view: 0 = call controls, 1 = screen shares.
    in-out property <int> call-tab;
    callback theme-changed(bool);
    callback close-to-tray-changed(bool);
    callback quit-app();

    public function apply-theme(dark: bool) {
        Theme.dark = dark;
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    init => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
        root.compact = root.width < 860px;
    }

    HorizontalLayout {
        if root.compact: Rectangle {
            width: 44px;
            background: Theme.bg-tertiary;
            VerticalLayout {
                padding: 6px;
                alignment: start;
                IconButton {
                    label: root.sidebar-open ? "×" : "≡";
                    tooltip: root.sidebar-open ? "Скрыть список диалогов" : "Показать список диалогов";
                    clicked => { root.sidebar-open = !root.sidebar-open; }
                }
            }
        }
        Sidebar {
            clip: true;
            new-group-open <=> root.new-group-open;
            active-call-title: root.active-call-title;
            incoming-title: root.incoming-title;
            create-group(t, u) => { root.create-group(t, u); }
            accept-call => { root.accept-call(); }
            decline-call => { root.decline-call(); }
            width: root.compact && !root.sidebar-open ? 0px : 240px;
            user-name: root.user-name;
            connection-status: root.connection-status;
            signed-in: root.signed-in;
            conversations: root.conversations;
            current: root.current-conversation;
            voice-selected: root.voice-selected;
            find-error: root.find-error;
            update-available: root.update-available;
            toggle-theme => {
                root.apply-theme(!Theme.dark);
                root.theme-changed(Theme.dark);
            }
            open-app-settings => { root.app-settings-open = !root.app-settings-open; }
            find-user(u) => { root.find-user(u); }
            open-conversation(id) => { root.sidebar-open = false; root.open-conversation(id); }
            open-voice => { root.sidebar-open = false; root.open-voice(); }
            logout => { root.logout(); }
        }
        // Content column: the connection banner (S7 step 4) over the current view.
        VerticalLayout {
        if root.banner-kind != 0: ConnectionBanner {
            kind: root.banner-kind;
            text: root.banner-text;
        }
        HorizontalLayout {
        if !root.voice-selected && !root.signed-in: AuthPanel {
            server: root.server-label;
            error: root.auth-error;
            busy: root.auth-busy;
            login(u, p) => { root.login(u, p); }
            register(u, p, d) => { root.register(u, p, d); }
        }
        if !root.voice-selected && root.signed-in && root.current-conversation == "": Rectangle {
            background: Theme.bg-primary;
            Text {
                text: "Выберите диалог слева или найдите собеседника по @username";
                color: Theme.text-muted;
            }
        }
        if !root.voice-selected && root.signed-in && root.current-conversation != "": ChatPanel {
            settings-open <=> root.group-settings-open;
            group: root.chat-group;
            can-manage: root.chat-can-manage;
            group-members: root.group-members;
            call-label: root.chat-call-label;
            call => { root.conversation-call(); }
            rename-group(t) => { root.rename-group(t); }
            add-member(u) => { root.add-group-member(u); }
            remove-member(u) => { root.remove-group-member(u); }
            title: root.chat-title;
            username: root.chat-username;
            online: root.chat-online;
            can-send: root.chat-can-send;
            blocked-by-me: root.chat-blocked-by-me;
            messages: root.messages;
            compose-mode: root.compose-mode;
            compose-label: root.compose-label;
            compose-text <=> root.compose-text;
            send(t) => { root.send-message(t); }
            reply-to(k) => { root.reply-to(k); }
            edit-message(k) => { root.edit-message(k); }
            delete-message(k) => { root.delete-message(k); }
            retry(k) => { root.retry-message(k); }
            discard(k) => { root.discard-message(k); }
            cancel-compose => { root.cancel-compose(); }
            toggle-block => { root.toggle-block(); }
            draft-changed(t) => { root.draft-changed(t); }
        }
        if root.voice-selected: VerticalLayout {
            Rectangle {
                height: 48px;
                background: Theme.bg-primary;
                HorizontalLayout {
                    padding-left: 16px;
                    spacing: 8px;
                    Text {
                        text: "Голосовая комната";
                        color: Theme.text-normal;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if root.compact: HorizontalLayout {
                        alignment: end;
                        padding: 8px;
                        spacing: 4px;
                        Button {
                            text: "Звонок";
                            primary: root.call-tab == 0;
                            clicked => { root.call-tab = 0; }
                        }
                        Button {
                            text: root.watching != "" ? "Экран •" : "Экран";
                            primary: root.call-tab == 1;
                            clicked => { root.call-tab = 1; }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.separator; }
            HorizontalLayout {
            CallPanel {
                managed: root.signed-in;
                has-participation: root.has-participation;
                // Narrow window: one panel at a time, chosen in the header.
                clip: true;
                min-width: root.compact && root.call-tab != 0 ? 0px : (root.compact ? 300px : 420px);
                max-width: root.compact && root.call-tab != 0 ? 0px : (root.compact ? 100000px : 560px);
                room-text <=> root.room-text;
                in-room: root.in-room;
                title: root.signed-in && root.active-call-title != "" ? root.active-call-title : root.call-title;
                detail: root.call-detail;
                stats: root.call-stats;
                devices: root.call-devices;
                error: root.call-error;
                mic-level: root.mic-level;
                self-speaking: root.self-speaking;
                dsp-available: root.dsp-available;
                members: root.members;
                voice-activation <=> root.voice-activation;
                vad-threshold <=> root.vad-threshold;
                muted <=> root.muted;
                ns <=> root.ns;
                aec <=> root.aec;
                inputs: root.inputs;
                outputs: root.outputs;
                input-index <=> root.input-index;
                output-index <=> root.output-index;
                remote-volume <=> root.remote-volume;
                join(r) => { root.join(r); }
                leave => { root.leave(); }
                mute-changed(m) => { root.mute-changed(m); }
                dsp-changed(n, a) => { root.dsp-changed(n, a); }
                input-selected(i) => { root.input-selected(i); }
                output-selected(i) => { root.output-selected(i); }
                remote-volume-changed(v) => { root.remote-volume-changed(v); }
                member-volume-changed(p, v) => { root.member-volume-changed(p, v); }
                vad-changed(on, t) => { root.vad-changed(on, t); }
            }
            Rectangle { width: root.compact ? 0px : 1px; background: Theme.separator; }
            ScreenPanel {
                clip: true;
                min-width: root.compact && root.call-tab == 0 ? 0px : 200px;
                max-width: root.compact && root.call-tab == 0 ? 0px : 100000px;
                in-room: root.in-room;
                monitors: root.monitors;
                monitor-index <=> root.monitor-index;
                quality-index <=> root.quality-index;
                share-audio <=> root.share-audio;
                sharing: root.sharing;
                share-info: root.share-info;
                shares: root.shares;
                watching: root.watching;
                picture: root.screen-picture;
                has-picture: root.has-picture;
                viewer-info: root.viewer-info;
                adaptive <=> root.adaptive;
                layer-index <=> root.layer-index;
                layer-info: root.layer-info;
                previews-visible <=> root.previews-visible;
                tile-width <=> root.tile-width;
                preview-page: root.preview-page;
                preview-pages: root.preview-pages;
                preview-info: root.preview-info;
                share-window-open: root.share-window-open;
                start-share(m, q, a) => { root.start-share(m, q, a); }
                stop-share => { root.stop-share(); }
                watch(p) => { root.watch(p); }
                share-audio-changed(on) => { root.share-audio-changed(on); }
                layer-selected(i) => { root.layer-selected(i); }
                previews-changed(v, page) => { root.previews-changed(v, page); }
                open-share-window(f) => { root.open-share-window(f); }
            }
            }
            Text {
                text: root.build-info;
                color: Theme.text-muted;
                font-size: 11px;
                horizontal-alignment: center;
            }
        }
        }
        }
    }

    // Above the user panel, over the sidebar and the content.
    if root.app-settings-open: Rectangle {
        x: 8px;
        y: root.height - self.height - 60px;
        width: 380px;
        height: settings-layout.preferred-height;
        background: Theme.bg-tertiary;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.separator;
        settings-layout := VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Text {
                text: "Настройки приложения";
                color: Theme.text-normal;
                font-weight: 600;
            }
            CheckBox {
                text: "Сворачивать в трей при закрытии окна";
                enabled: root.tray-available;
                checked <=> root.close-to-tray;
                toggled => { root.close-to-tray-changed(self.checked); }
            }
            Text {
                text: root.tray-available
                    ? "Звонок и переписка продолжают работать в фоне; «Выйти» в меню значка завершает приложение."
                    : "Значок в области уведомлений недоступен: закрытие окна завершает приложение.";
                color: Theme.text-muted;
                font-size: 11px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Масштаб интерфейса";
                    color: Theme.text-normal;
                    vertical-alignment: center;
                }
                ComboBox {
                    model: ["100 %", "125 %", "150 %", "175 %", "200 %"];
                    current-index <=> root.ui-scale-index;
                    selected => { root.ui-scale-changed(self.current-index); }
                }
            }
            Text {
                text: "Масштаб применяется после перезапуска приложения.";
                color: Theme.text-muted;
                font-size: 11px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.update-text;
                    color: root.update-available ? Theme.text-normal : Theme.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.update-button != "": Button {
                    text: root.update-button;
                    primary: root.update-available;
                    clicked => { root.update-action(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "Выйти из приложения";
                    clicked => { root.quit-app(); }
                }
                Button {
                    text: "Закрыть";
                    clicked => { root.app-settings-open = false; }
                }
            }
        }
    }
}
