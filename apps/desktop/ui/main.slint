// DsMini main window (S0 shell).
// Layout follows the spec: conversation list on the left, conversation area on
// the right, user panel at the bottom-left. No server/channel rail by design.

export global Theme {
    in-out property <bool> dark: true;
    out property <color> bg-tertiary: dark ? #1e1f22 : #e3e5e8;
    out property <color> bg-secondary: dark ? #2b2d31 : #f2f3f5;
    out property <color> bg-primary: dark ? #313338 : #ffffff;
    out property <color> text-normal: dark ? #dbdee1 : #313338;
    out property <color> text-muted: dark ? #949ba4 : #5c5e66;
    out property <color> accent: #5865f2;
    out property <color> separator: dark ? #26282c : #d4d7dc;
    out property <length> font-size: 14px;
}

component IconButton inherits Rectangle {
    in property <string> label;
    in property <string> tooltip;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: touch.has-hover || focus.has-focus ? (Theme.dark ? #3f4147 : #d7d9dc) : transparent;
    accessible-role: button;
    accessible-label: tooltip;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Sidebar inherits Rectangle {
    in property <string> user-name;
    in property <string> connection-status;
    callback toggle-theme;
    background: Theme.bg-secondary;
    VerticalLayout {
        Rectangle {
            height: 48px;
            border-width: 0px;
            HorizontalLayout {
                padding: 10px;
                Rectangle {
                    background: Theme.bg-tertiary;
                    border-radius: 4px;
                    Text {
                        x: 8px;
                        text: "Найти по @username";
                        color: Theme.text-muted;
                        font-size: 13px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.separator; }
        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            Text {
                text: "ЛИЧНЫЕ СООБЩЕНИЯ";
                color: Theme.text-muted;
                font-size: 11px;
                font-weight: 700;
            }
            Text {
                text: "Пока нет диалогов";
                color: Theme.text-muted;
                font-size: Theme.font-size;
            }
            Rectangle { }
        }
        // User panel
        Rectangle {
            height: 52px;
            background: Theme.dark ? #232428 : #ebedef;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: stretch;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 16px;
                    background: Theme.accent;
                    Text {
                        text: root.user-name.character-count > 0 ? "D" : "?";
                        color: white;
                        font-weight: 700;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.user-name;
                        color: Theme.text-normal;
                        font-size: 13px;
                        font-weight: 600;
                    }
                    Text {
                        text: root.connection-status;
                        color: Theme.text-muted;
                        font-size: 11px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        label: Theme.dark ? "☀" : "☾";
                        tooltip: "Переключить тему";
                        clicked => { root.toggle-theme(); }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "DsMini";
    preferred-width: 1100px;
    preferred-height: 700px;
    min-width: 640px;
    min-height: 420px;
    background: Theme.bg-primary;
    default-font-size: Theme.font-size;

    in property <string> user-name: "DsMini";
    in property <string> connection-status: "Не подключено";
    in property <string> build-info;

    HorizontalLayout {
        Sidebar {
            width: 240px;
            user-name: root.user-name;
            connection-status: root.connection-status;
            toggle-theme => { Theme.dark = !Theme.dark; }
        }
        VerticalLayout {
            Rectangle {
                height: 48px;
                background: Theme.bg-primary;
                HorizontalLayout {
                    padding-left: 16px;
                    Text {
                        text: "Диалог не выбран";
                        color: Theme.text-normal;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.separator; }
            Rectangle {
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text {
                        text: "Выберите диалог или найдите собеседника по @username";
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.build-info;
                        color: Theme.text-muted;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
