// Design system: colour tokens (dark/light), sizes, icons and the styled controls the
// rest of the UI is built from. An original look (warm accent from the app icon,
// dense dark layout) — no third-party art: every icon below is a hand-written path.

export global Theme {
    in-out property <bool> dark: true;

    // Surfaces, from the deepest to the raised ones.
    out property <color> bg-base: dark ? #16171b : #e3e5e9;
    out property <color> bg-sidebar: dark ? #1d1e23 : #eff0f3;
    out property <color> bg-content: dark ? #25262c : #ffffff;
    out property <color> bg-elevated: dark ? #2e3037 : #ffffff;
    out property <color> bg-input: dark ? #1a1b20 : #ebedf0;
    out property <color> bg-floating: dark ? #0d0e11 : #1f2026;
    out property <color> bg-stage: dark ? #121317 : #e9ebef;
    out property <color> bg-tile: dark ? #24262c : #ffffff;
    // Overlays: work on any surface.
    out property <color> hover: dark ? #ffffff0d : #0000000b;
    out property <color> pressed: dark ? #ffffff17 : #00000014;
    out property <color> selected: dark ? #ffffff1a : #00000017;
    out property <color> msg-hover: dark ? #0000001f : #00000007;
    out property <color> backdrop: dark ? #000000b3 : #0b0c0f8c;

    // Text levels.
    out property <color> text-strong: dark ? #f3f4f6 : #121317;
    out property <color> text-normal: dark ? #d7d9de : #2b2d33;
    out property <color> text-muted: dark ? #9b9ea8 : #5d6069;
    out property <color> text-faint: dark ? #6d707b : #8b8e97;
    out property <color> text-on-accent: #ffffff;

    // Accent (the icon's coral) and states.
    out property <color> accent: #e8603c;
    out property <color> accent-hover: #d4532f;
    out property <color> accent-pressed: #bd4726;
    out property <color> accent-soft: dark ? #e8603c2e : #e8603c1f;
    out property <color> accent-text: dark ? #ff8f6b : #c2461f;
    out property <color> success: #2ea866;
    out property <color> success-hover: #258c55;
    out property <color> success-text: dark ? #4fd18a : #1d7f49;
    out property <color> warning: #d9930d;
    out property <color> danger: #e5484d;
    out property <color> danger-hover: #c93a3f;
    out property <color> danger-text: dark ? #ff6b70 : #c62f35;
    out property <color> danger-soft: dark ? #e5484d26 : #e5484d1a;
    out property <color> offline: dark ? #80838d : #8b8e97;

    // Lines and depth (the software renderer draws no blur: shadows are layered rims).
    out property <color> separator: dark ? #ffffff0f : #0000001a;
    out property <color> border: dark ? #ffffff14 : #0000001f;
    out property <color> border-strong: dark ? #ffffff24 : #00000033;
    out property <color> shadow: dark ? #00000066 : #0000001f;
    out property <color> toggle-off: dark ? #4a4d57 : #c4c7ce;

    // Kept names (older views and Rust-side expectations).
    out property <color> bg-tertiary: bg-base;
    out property <color> bg-secondary: bg-sidebar;
    out property <color> bg-primary: bg-content;

    // Radii, spacing, type.
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;
    out property <length> radius-xl: 16px;
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;
    out property <length> font-xs: 11px;
    out property <length> font-sm: 12px;
    out property <length> font-size: 14px;
    out property <length> font-lg: 16px;
    out property <length> font-xl: 20px;
    out property <length> font-xxl: 24px;
    out property <duration> fast: 120ms;
    out property <duration> normal: 180ms;

    // Avatar palette: the index comes from Rust (`chat::avatar_index`, 8 colours).
    public pure function avatar(i: int) -> color {
        if i == 1 { return #3d7be0; }
        if i == 2 { return #8a57d6; }
        if i == 3 { return #23966a; }
        if i == 4 { return #c97a1c; }
        if i == 5 { return #d24f7c; }
        if i == 6 { return #1990a8; }
        if i == 7 { return #5865d0; }
        return #d65a35;
    }
}

