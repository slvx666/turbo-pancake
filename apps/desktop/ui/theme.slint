// One icon drawn from a path above.
export component Icon inherits Rectangle {
    in property <string> icon;
    in property <brush> tint: Theme.text-muted;
    in property <bool> filled;
    in property <length> size: 20px;
    in property <length> stroke: max(1.4px, root.size * 0.085);
    width: root.size;
    height: root.size;
    accessible-role: none;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        fill: root.filled ? root.tint : transparent;
        stroke: root.filled ? transparent : root.tint;
        stroke-width: root.filled ? 0px : root.stroke;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// Tooltip shared by all icon buttons; drawn once by the window (never clipped).
export global Tip {
    in-out property <string> text;
    in-out property <bool> shown;
    in-out property <bool> below;
    in-out property <length> ax;
    in-out property <length> ay;
    in-out property <length> aw;
    in-out property <length> ah;
    in-out property <int> serial;
}

// The tooltip bubble (placed by MainWindow above everything).
export component TooltipLayer inherits Rectangle {
    in property <length> area-width;
    in property <length> area-height;
    property <bool> place-below: Tip.below || Tip.ay - 40px < 4px;
    if Tip.shown && Tip.text != "": bubble := Rectangle {
        x: max(4px, min(root.area-width - self.width - 4px, Tip.ax + Tip.aw / 2 - self.width / 2));
        y: root.place-below ? Tip.ay + Tip.ah + 8px : Tip.ay - self.height - 8px;
        width: tip-text.preferred-width + 20px;
        height: tip-text.preferred-height + 12px;
        border-radius: 6px;
        background: Theme.bg-floating;
        border-width: 1px;
        border-color: #ffffff12;
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { delay: 300ms; duration: 90ms; }
        tip-text := Text {
            text: Tip.text;
            color: #f1f2f4;
            font-size: 12px;
            font-weight: 600;
            accessible-role: none;
        }
    }
}

// What a styled button looks like.
export enum ButtonKind { secondary, primary, danger, ghost, success, link }

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <ButtonKind> kind: ButtonKind.secondary;
    in property <bool> enabled: true;
    in property <bool> small;
    in property <bool> stretch-text;
    callback clicked;
    property <bool> hovered: touch.has-hover && root.enabled;
    property <bool> down: touch.pressed && root.enabled;
    property <color> base: root.kind == ButtonKind.primary ? Theme.accent
        : root.kind == ButtonKind.danger ? Theme.danger
        : root.kind == ButtonKind.success ? Theme.success
        : root.kind == ButtonKind.secondary ? (Theme.dark ? #3a3c44 : #e3e5e9)
        : transparent;
    property <color> hover-bg: root.kind == ButtonKind.primary ? Theme.accent-hover
        : root.kind == ButtonKind.danger ? Theme.danger-hover
        : root.kind == ButtonKind.success ? Theme.success-hover
        : root.kind == ButtonKind.secondary ? (Theme.dark ? #44474f : #d8dbe0)
        : root.kind == ButtonKind.link ? transparent : Theme.hover;
    property <color> fg: root.kind == ButtonKind.secondary ? Theme.text-strong
        : root.kind == ButtonKind.ghost ? Theme.text-normal
        : root.kind == ButtonKind.link ? Theme.accent-text
        : Theme.text-on-accent;
    min-height: root.small ? 28px : 36px;
    min-width: layout.preferred-width;
    horizontal-stretch: 0;
    border-radius: root.small ? 6px : 8px;
    background: root.down ? root.hover-bg.darker(0.12) : root.hovered ? root.hover-bg : root.base;
    opacity: root.enabled ? 1 : 0.45;
    animate background { duration: Theme.fast; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    // Keyboard focus ring.
    if focus.has-focus: Rectangle {
        border-radius: root.border-radius + 2px;
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
        border-width: 2px;
        border-color: Theme.accent-text;
    }
    layout := HorizontalLayout {
        padding-left: root.kind == ButtonKind.link ? 2px : (root.small ? 10px : 16px);
        padding-right: root.kind == ButtonKind.link ? 2px : (root.small ? 10px : 16px);
        spacing: 6px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            size: root.small ? 15px : 17px;
            tint: root.fg;
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: root.small ? 12px : 14px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }
}

// Square or round icon button with a tooltip on hover.
export component IconButton inherits Rectangle {
    in property <string> icon;
    // Text glyph used when there is no icon.
    in property <string> label;
    in property <string> tooltip;
    in property <bool> tooltip-below;
    in property <bool> enabled: true;
    // Toggled on (e.g. a panel that is open).
    in property <bool> active;
    // Red when "active" (muted microphone) and on hover for destructive buttons.
    in property <bool> danger;
    in property <bool> filled;
    in property <length> size: 32px;
    in property <length> icon-size: 20px;
    in property <bool> round;
    in property <color> tint: Theme.text-muted;
    callback clicked;
    property <int> my-serial: -1;
    property <bool> hovered: touch.has-hover && root.enabled;
    width: root.size;
    height: root.size;
    border-radius: root.round ? root.size / 2 : 6px;
    background: touch.pressed && root.enabled ? Theme.pressed
        : root.active && root.danger ? Theme.danger-soft
        : root.hovered || focus.has-focus ? Theme.hover
        : root.active ? Theme.selected : transparent;
    opacity: root.enabled ? 1 : 0.4;
    animate background { duration: Theme.fast; }
    accessible-role: button;
    accessible-label: root.tooltip != "" ? root.tooltip : root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            Tip.shown = false;
            root.clicked();
        }
        changed has-hover => {
            if self.has-hover && root.tooltip != "" {
                Tip.serial += 1;
                root.my-serial = Tip.serial;
                Tip.text = root.tooltip;
                Tip.ax = root.absolute-position.x;
                Tip.ay = root.absolute-position.y;
                Tip.aw = root.width;
                Tip.ah = root.height;
                Tip.below = root.tooltip-below;
                Tip.shown = true;
            } else if !self.has-hover && Tip.serial == root.my-serial {
                Tip.shown = false;
            }
        }
    }
    if root.icon != "": Icon {
        icon: root.icon;
        size: root.icon-size;
        filled: root.filled;
        tint: root.active && root.danger ? Theme.danger-text
            : root.hovered && root.danger ? Theme.danger-text
            : root.hovered || root.active ? Theme.text-strong : root.tint;
        animate tint { duration: Theme.fast; }
    }
    if root.icon == "": Text {
        text: root.label;
        color: root.hovered ? Theme.text-strong : root.tint;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// Big round control (call bar, incoming call).
export enum RoundKind { neutral, off, danger, success, accent }

export component RoundButton inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    in property <RoundKind> kind: RoundKind.neutral;
    in property <bool> enabled: true;
    in property <bool> filled;
    in property <length> size: 48px;
    callback clicked;
    property <int> my-serial: -1;
    property <bool> hovered: touch.has-hover && root.enabled;
    property <color> base: root.kind == RoundKind.danger ? Theme.danger
        : root.kind == RoundKind.success ? Theme.success
        : root.kind == RoundKind.accent ? Theme.accent
        : root.kind == RoundKind.off ? (Theme.dark ? #f2f3f5 : #2b2d33)
        : (Theme.dark ? #30333a : #ffffff);
    property <color> fg: root.kind == RoundKind.off ? (Theme.dark ? #c62f35 : #ff8a8d)
        : root.kind == RoundKind.neutral ? Theme.text-strong : #ffffff;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: touch.pressed && root.enabled ? root.base.darker(0.25)
        : root.hovered ? root.base.darker(0.12) : root.base;
    border-width: root.kind == RoundKind.neutral ? 1px : 0px;
    border-color: Theme.border;
    opacity: root.enabled ? 1 : 0.4;
    animate background { duration: Theme.fast; }
    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            Tip.shown = false;
            root.clicked();
        }
        changed has-hover => {
            if self.has-hover && root.tooltip != "" {
                Tip.serial += 1;
                root.my-serial = Tip.serial;
                Tip.text = root.tooltip;
                Tip.ax = root.absolute-position.x;
                Tip.ay = root.absolute-position.y;
                Tip.aw = root.width;
                Tip.ah = root.height;
                Tip.below = false;
                Tip.shown = true;
            } else if !self.has-hover && Tip.serial == root.my-serial {
                Tip.shown = false;
            }
        }
    }
    if focus.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.accent-text;
    }
    Icon {
        icon: root.icon;
        filled: root.filled;
        size: root.size * 0.46;
        tint: root.fg;
    }
}

// On/off switch.
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled(bool);
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? Theme.success : Theme.toggle-off;
    opacity: root.enabled ? 1 : 0.45;
    animate background { duration: Theme.normal; }
    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.flip(); }
    forward-focus: focus;
    public function flip() {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.flip();
                return accept;
            }
            reject
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.flip(); }
    }
    if focus.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: self.height / 2;
        border-width: 2px;
        border-color: Theme.accent-text;
    }
    Rectangle {
        x: root.checked ? root.width - self.width - 3px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        animate x { duration: Theme.normal; easing: ease-out; }
        if root.checked: Icon {
            icon: Icons.check;
            size: 12px;
            stroke: 2px;
            tint: Theme.success;
        }
    }
}

// A labelled settings row with a switch on the right; the whole row toggles it.
export component ToggleRow inherits Rectangle {
    in property <string> text;
    in property <string> description;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled(bool);
    min-height: row.preferred-height;
    border-radius: 8px;
    background: touch.has-hover && root.enabled ? Theme.hover : transparent;
    animate background { duration: Theme.fast; }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { switch.flip(); }
    }
    row := HorizontalLayout {
        padding: 10px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.text;
                color: root.enabled ? Theme.text-strong : Theme.text-muted;
                font-weight: 600;
                wrap: word-wrap;
            }
            if root.description != "": Text {
                text: root.description;
                color: Theme.text-muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            switch := Toggle {
                label: root.text;
                enabled: root.enabled;
                checked <=> root.checked;
                toggled(on) => { root.toggled(on); }
            }
        }
    }
}

// Small rounded count / status label.
export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> bg: Theme.danger;
    in property <color> text-color: #ffffff;
    in property <length> font-size: 11px;
    height: root.font-size + 7px;
    width: max(self.height, label.preferred-width + 10px);
    border-radius: self.height / 2;
    background: root.bg;
    label := Text {
        text: root.text;
        color: root.text-color;
        font-size: root.font-size;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// "ДИАЛОГИ И ГРУППЫ"-style caption.
export component SectionHeader inherits Text {
    color: Theme.text-muted;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.4px;
    vertical-alignment: center;
    overflow: elide;
}

// Initials on a stable colour; groups get a rounded square and a people glyph;
// presence as a dot cut out of the avatar's corner.
export component Avatar inherits Rectangle {
    in property <string> initials;
    in property <int> color-index;
    in property <bool> group;
    in property <length> size: 32px;
    // 0 none, 1 online, 2 offline.
    in property <int> presence;
    // The surface behind the avatar (the cut-out ring takes its colour).
    in property <color> ring-color: Theme.bg-sidebar;
    width: root.size;
    height: root.size;
    accessible-role: none;
    Rectangle {
        border-radius: root.group ? root.size * 0.3 : root.size / 2;
        background: Theme.avatar(root.color-index);
        if !root.group || root.size < 28px: Text {
            text: root.initials;
            color: #ffffff;
            font-size: root.size * (root.initials.character-count > 1 ? 0.36 : 0.42);
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.group && root.size >= 28px: Icon {
            icon: Icons.users;
            size: root.size * 0.55;
            tint: #ffffff;
            stroke: max(1.5px, root.size * 0.06);
        }
    }
    if root.presence > 0: Rectangle {
        property <length> d: max(10px, root.size * 0.36);
        x: root.width - self.d + 2px;
        y: root.height - self.d + 2px;
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        background: root.ring-color;
        accessible-role: text;
        accessible-label: root.presence == 1 ? "в сети" : "не в сети";
        Rectangle {
            width: parent.d - 5px;
            height: parent.d - 5px;
            border-radius: self.width / 2;
            background: root.presence == 1 ? Theme.success : root.ring-color;
            border-width: root.presence == 1 ? 0px : max(2px, self.width * 0.28);
            border-color: Theme.offline;
        }
    }
}

// Single-line text field in the app's style (search, forms): scrolls with the cursor
// like the standard LineEdit, with a placeholder, an optional leading icon and a
// copy/paste context menu.
export component Field inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <string> icon;
    in property <InputType> input-type: InputType.text;
    in property <bool> enabled: true;
    in property <length> field-height: 40px;
    in property <color> field-background: Theme.bg-input;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);
    property <length> margin: 4px;
    height: root.field-height;
    min-width: 60px;
    border-radius: 8px;
    background: root.field-background;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : (touch.has-hover && root.enabled ? Theme.border-strong : Theme.border);
    opacity: root.enabled ? 1 : 0.55;
    animate border-color { duration: Theme.fast; }
    forward-focus: input;
    accessible-role: none;
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    HorizontalLayout {
        padding-left: root.icon != "" ? 10px : 12px;
        padding-right: 10px;
        spacing: 8px;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            size: 16px;
            tint: Theme.text-faint;
        }
        clip-area := Rectangle {
            clip: true;
            horizontal-stretch: 1;
            min-width: 1px;
            placeholder := Text {
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                text: input.text == "" && input.preedit-text == "" ? root.placeholder : "";
                color: Theme.text-faint;
                font-size: input.font-size;
                overflow: elide;
                accessible-role: none;
            }
            ContextMenuArea {
                enabled: root.enabled;
                Menu {
                    MenuItem {
                        title: "Вырезать";
                        enabled: root.input-type != InputType.password;
                        activated => { input.cut(); }
                    }
                    MenuItem {
                        title: "Копировать";
                        enabled: root.input-type != InputType.password;
                        activated => { input.copy(); }
                    }
                    MenuItem {
                        title: "Вставить";
                        activated => { input.paste(); }
                    }
                    MenuItem {
                        title: "Выделить всё";
                        activated => { input.select-all(); }
                    }
                }
                input := TextInput {
                    property <length> computed-x;
                    x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                    width: max(parent.width - self.text-cursor-width, self.preferred-width);
                    height: 100%;
                    vertical-alignment: center;
                    single-line: true;
                    enabled: root.enabled;
                    input-type: root.input-type;
                    color: Theme.text-strong;
                    font-size: 14px;
                    selection-background-color: Theme.accent.with-alpha(0.45);
                    selection-foreground-color: Theme.text-strong;
                    accessible-placeholder-text: root.placeholder;
                    cursor-position-changed(cursor-position) => {
                        if cursor-position.x + self.computed-x < root.margin {
                            self.computed-x = - cursor-position.x + root.margin;
                        } else if cursor-position.x + self.computed-x > parent.width - root.margin - self.text-cursor-width {
                            self.computed-x = parent.width - cursor-position.x - root.margin - self.text-cursor-width;
                        }
                    }
                    accepted => { root.accepted(self.text); }
                    edited => { root.edited(self.text); }
                }
            }
        }
    }
}

// A card: raised surface with a hairline rim and a layered soft shadow (also drawn by
// the software renderer, which has no blur).
export component Card inherits Rectangle {
    in property <length> radius: 12px;
    in property <color> fill: Theme.bg-elevated;
    in property <bool> shadow: true;
    border-radius: root.radius;
    if root.shadow: Rectangle {
        x: -3px;
        y: -1px;
        width: root.width + 6px;
        height: root.height + 7px;
        border-radius: root.radius + 3px;
        background: Theme.shadow.transparentize(0.65);
    }
    if root.shadow: Rectangle {
        x: -1px;
        y: 0px;
        width: root.width + 2px;
        height: root.height + 3px;
        border-radius: root.radius + 1px;
        background: Theme.shadow.transparentize(0.4);
    }
    Rectangle {
        border-radius: root.radius;
        background: root.fill;
        border-width: 1px;
        border-color: Theme.border;
    }
    @children
}
